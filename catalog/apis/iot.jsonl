{"access":{"model":"unknown","notes":null},"category":"iot","coverage":{"geographic":null,"temporal":null},"curation":{"level":"imported","updated":"2026-10-24"},"description":"IOTVAS API enables you to discover IoT/Connected devices in the network and provides detailed real-time risk analysis, including firmware vulnerability analysis without requiring the user to upload the firmware file. Please visit the signup page to create an API key. IoTVAS API can be easily integrated with vulnerability scanning and network port scanner tools. For example, we have also released the IOTVAS NSE script that turns the nmap port scanner to a IoT/connected device discovery and real-time risk assessment tool. For more infromation on IoTVAS and other solutions please visit Firmalyzer web site.","formats":[],"id":"firmalyzer.com/iotvas-api","kind":"api","license":{"attribution_required":null,"basis":null,"commercial_use":"unknown","name":null,"notes":null,"spdx":null,"url":null},"name":"IoTVAS API","notes":null,"pricing":{"basis":null,"free_tier_indicated":null,"free_tier_limits":null,"model":"unknown","notes":null},"provenance":[{"imported_at":"2026-10-23","source":"apis-guru","source_license":"CC0-1.0","source_url":"https://apis.guru/browse-apis","source_version":"f04b8d0bcd39c52e1cf3ad7a5fe744709832ae49","upstream_id":"firmalyzer.com:iotvas@1.0"}],"provider":{"domain":"firmalyzer.com","id":"firmalyzer.com","name":"firmalyzer.com:iotvas"},"status":"unverified","tags":["iot","security"],"technical":{"auth_schemes":[],"cors":"unknown","https":null},"type":"openapi","update_frequency":"unknown","urls":{"documentation":"https://iotvas-api.firmalyzer.com/api/v1/openapi.json","signup":null,"spec":"https://api.apis.guru/v2/specs/firmalyzer.com/iotvas/1.0/openapi.json","terms":null,"website":"https://firmalyzer.com"},"verification":{"confidence":"imported","http_status":null,"last_checked":"2026-10-24","last_verified":null,"method":"upstream_import","notes":"The read operation timed out"}}
